# NoneBot command prefix example
COMMAND_START=["/"]
LOG_LEVEL=INFO

# Kuwo plugin settings
KUWO_SEARCH_LIMIT=5
KUWO_LIST_RENDER_MODE=text
KUWO_TRACK_RENDER_MODE=text  # support: text | card | record | file
KUWO_DEFAULT_QUALITY=standard
# KUWO_TRACK_PROXY_URL=http://127.0.0.1:7890  # optional HTTP/HTTPS proxy for track link requests
KUWO_TRACK_CACHE_RETENTION_DAYS=1  # 0 disables age-based cleanup
KUWO_TRACK_CACHE_MAX_SIZE_MB=1024  # 0 disables size-based cleanup; not recommended below 600MB
# KUWO_RENDER_FONT_FILES=["/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"]  # optional extra font files for image rendering
# KUWO_RENDER_FONT_DIRS=["/usr/share/fonts"]  # optional extra font directories for image rendering
